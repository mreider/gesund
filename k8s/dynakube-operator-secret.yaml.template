# This is a template for the Dynatrace Operator secret.
# 1. Rename this file to 'dynakube-operator-secret.yaml' in the same directory (k8s/).
# 2. Fill in your actual Dynatrace API Token and Data Ingest Token below.
#
# This secret will be applied to the 'dynatrace' namespace and is used by the Dynatrace Operator.
# The 'metadata.name' must be 'dynakube' as this is what the Dynatrace Operator typically expects.
#
# Ensure 'k8s/dynakube-operator-secret.yaml' is listed in your .gitignore file.

apiVersion: v1
kind: Secret
metadata:
  # The name 'dynakube' is typically expected by the Dynatrace Operator for its configuration secret.
  name: dynakube
type: Opaque
stringData:
  # Dynatrace API Token for the Operator:
  # This token is used by the Dynatrace Operator to communicate with your Dynatrace environment.
  # Required permissions typically include:
  # - "Access problems and event feed, metrics, and topology"
  # - "PaaS integration"
  # Placeholder: YOUR_DYNATRACE_OPERATOR_API_TOKEN_HERE
  apiToken: "YOUR_DYNATRACE_OPERATOR_API_TOKEN_HERE"

  # Dynatrace Data Ingest Token:
  # This token is used for various data ingestion purposes, including metrics, logs, and traces if configured.
  # Required permissions typically include:
  # - "Ingest metrics" (Scope: metrics.ingest)
  # - "Ingest logs" (Scope: logs.ingest) - If log ingestion is enabled
  # - "Ingest traces" (Scope: openTelemetryTrace.ingest) - If OpenTelemetry trace ingestion is enabled
  # - "Ingest events" (Scope: events.ingest) - If event ingestion is enabled
  # Placeholder: YOUR_DYNATRACE_DATA_INGEST_TOKEN_HERE
  dataIngestToken: "YOUR_DYNATRACE_DATA_INGEST_TOKEN_HERE"
